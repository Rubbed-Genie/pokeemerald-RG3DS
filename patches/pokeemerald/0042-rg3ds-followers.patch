+// Remove follower object. Idempotent.
+void RemoveFollowingPokemon(void) {
+    struct ObjectEvent *objectEvent = GetFollowerObject();
+    if (objectEvent == NULL)
+        return;
+    RemoveObjectEvent(objectEvent);
+}
