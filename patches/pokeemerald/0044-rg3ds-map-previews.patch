+#ifdef PORT_BRIDGE
+// RG3DS: whether a preview card is up (ForestMapPreviewScreenIsRunning
+// answers the opposite, despite its name: TRUE once it has finished).
+bool32 CtrMapPreview_Showing(void)
+{
+    return FuncIsActiveTask(Task_RunMapPreviewScreenForest);
+}
